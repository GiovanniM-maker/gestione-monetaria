# Copia questo file in `.env.local` e riempi i valori.
# `.env*` e' escluso da git: non aggiungere mai valori reali qui dentro.
#
# Regola non negoziabile: nessun segreto in variabili NEXT_PUBLIC_*.
# Le due variabili NEXT_PUBLIC_SUPABASE_* qui sotto NON sono segreti — sono
# progettate per stare nel bundle client e sono inutili senza RLS a monte.

# --- Supabase ----------------------------------------------------------------
# I valori si copiano dal pannello "Connect" del progetto Supabase, che usa la
# nomenclatura nuova delle chiavi. Corrispondenza:
#
#   SUPABASE_URL              -> NEXT_PUBLIC_SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEY  -> NEXT_PUBLIC_SUPABASE_ANON_KEY  (sb_publishable_...)
#
# Teniamo il nome storico ANON_KEY perche' e' quello che @supabase/ssr si
# aspetta come secondo argomento; il valore da incollare e' la publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATTENZIONE — nello stesso pannello compare anche `SUPABASE_SECRET_KEY`
# (`sb_secret_...`), erede della service role key: bypassa completamente la RLS.
# Non va in nessuna variabile NEXT_PUBLIC_*, non serve in Fase 0, e quando
# servira' sara' una variabile server-only. Non aggiungerla qui.

# --- Applicazione ------------------------------------------------------------
# Unico indirizzo autorizzato ad accedere. Confrontato dopo trim + lowercase.
ALLOWED_EMAIL=

# --- Scheduler ---------------------------------------------------------------
# SEGRETO. Stringa casuale lunga (es. `openssl rand -hex 32`).
# Impostandola su Vercel, Vercel Cron invia automaticamente
# `Authorization: Bearer ${CRON_SECRET}` alle route /api/cron/*.
# Serve dalla Fase 7: in Fase 0 non esiste ancora nessuna route cron.
CRON_SECRET=
